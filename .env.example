# Database Configuration (TimescaleDB / Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=needpipsforporsche
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/needpipsforporsche?sslmode=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Ingestion Engine & Ports
ENGINE_PORT=8080
ENGINE_WS_URL=ws://localhost:8080/ws/live

# VPS MT5 Bridge Configuration (Isi dengan IP VPS Windows saat sudah aktif)
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=8080
MT5_ACCOUNT=12345678
MT5_PASSWORD=your_hfm_password_here
MT5_SERVER=HFMarketsSV-Live
MT5_SYMBOL=XAUUSD

# Web Dashboard (Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENGINE_WS_URL=ws://localhost:8080/ws/live

# Security / Vault Master Key (AES-256-GCM 32-byte hex)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUTH_SECRET=supersecretjwtstringchangethisinproduction

# AI Trade Evaluator (Optional - isi jika pakai OpenAI / Groq / Anthropic)
